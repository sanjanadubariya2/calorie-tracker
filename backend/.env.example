# Calorie Tracker API — configuration.
# Copy to backend/.env for local development (git-ignored), or set these as
# environment variables / secrets in your hosting platform. Never commit a
# filled-in copy.

# development | test | production (default: production, which also enforces
# https and an explicit CORS allow-list).
ENVIRONMENT=development

# Your Supabase project URL (Project Settings -> API), no trailing slash.
SUPABASE_URL=https://your-project-ref.supabase.co

# The project's anon / publishable key (the same one the app ships with).
# Sent as `apikey` to PostgREST; it grants nothing beyond what RLS allows.
# Do NOT put the service-role / secret key here: this service never needs it.
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Algorithms accepted for user access tokens. Supabase projects using signing
# keys (the default, and what this project uses) sign with ES256; check
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json. Only add HS256 if the project
# still uses the legacy JWT secret, and then also set SUPABASE_JWT_SECRET.
SUPABASE_JWT_ALGORITHMS=ES256
# SUPABASE_JWT_SECRET=

# Optional overrides (defaults are derived from SUPABASE_URL):
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Exact web origins allowed to call the API from a browser, comma-separated.
# Required in production. Native apps don't send an Origin and aren't affected.
ALLOWED_ORIGINS=http://localhost:8081

# Port inside the container (default 8000).
# PORT=8000
