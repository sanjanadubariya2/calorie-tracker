# Copy this file to .env and fill in your own Supabase project credentials.
# Find these in Supabase Dashboard -> Project Settings -> API

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Set to "true" to run the app fully offline against fake in-memory data,
# with no Supabase project needed. Great for UI development before your
# backend is wired up. Set to "false" (or remove) once ready to go live.
EXPO_PUBLIC_MOCK_MODE=true
